<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Alternate.Bouwcontrole.Alpha</title>
    @* Bootstrap komt via internet, niet uit wwwroot/lib. Zie LEESMIJ.md. *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Alternate.Bouwcontrole.Alpha.styles.css" asp-append-version="true" />
</head>
<body>
    @* Het header-blok met de navigatiebalk en het footer-blok zijn weg (stap 5 in de brainstorm) *@
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
